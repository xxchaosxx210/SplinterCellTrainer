<Window x:Class="SCTrainer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SCTrainer"
 Title="{x:Static local:VersionInfo.TrainerLabel}" Width="820" Height="680" MinWidth="640" MinHeight="400"
 WindowStartupLocation="CenterScreen" Background="#0B100E" Foreground="#EDF1EA" FontFamily="Segoe UI"
 UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="64"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid><Grid.RowDefinitions><RowDefinition Height="175"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ClipToBounds="True">
   <Image Source="Assets/splinter-cell-header.jpg" Stretch="UniformToFill" HorizontalAlignment="Right" Width="650" Opacity="0.85"/>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0B100E" Offset="0"/><GradientStop Color="#E60B100E" Offset="0.37"/><GradientStop Color="#200B100E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000B100E" Offset=".55"/><GradientStop Color="#FF0B100E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <StackPanel Margin="24,18,0,0">
    <TextBlock Text="TOM CLANCY’S" Foreground="#A5B09F" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock Text="SPLINTER CELL" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
    <TextBlock Text="TRAINER" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" Margin="1,3,0,0"/>
    <TextBlock Text="Your mission. Your rules." Foreground="#A5B09F" Margin="1,18,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="24,0,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#141C17" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#8A958B" Width="8" Height="8" Margin="0,0,9,0"/><TextBlock x:Name="GameStatus" Text="Checking for game…" FontSize="15" FontWeight="SemiBold"/></StackPanel>
      <TextBlock x:Name="GameDetail" Text="Looking for SplinterCell.exe" Foreground="#94A192" FontSize="12" Margin="17,6,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="HealthStatus" Text="Infinite health is off." Foreground="#B5EF65" FontSize="12" TextWrapping="Wrap" Margin="17,6,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Refresh game detection"/>
    </Grid>
   </Border>
   <Border Grid.Row="2" Background="#141C17" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="8" Padding="18">
 <StackPanel>
  <TextBlock Text="LOAD LEVEL" Foreground="#C9D7C2" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox Grid.ColumnSpan="2" x:Name="LevelPicker" DisplayMemberPath="Label" MinHeight="36" VerticalContentAlignment="Center" FontSize="14" AutomationProperties.Name="Select level"/>
   <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="TestConnectionButton" Content="Test connection" Click="TestConnection_Click" Margin="12,0,0,0"/><Button x:Name="LoadLevelButton" Content="Load level" Click="LoadLevel_Click" Margin="8,0,0,0"/></StackPanel>
  </Grid>
  <TextBlock x:Name="LevelStatus" Text="Load maps from the game's main menu. Active-mission switches are blocked to avoid the reproduced crash." TextWrapping="Wrap" Foreground="#94A192" FontSize="12" Margin="0,10,0,0"/>
 </StackPanel>
</Border>
<Border Grid.Row="4" Background="#111813" BorderBrush="#263329" BorderThickness="1" CornerRadius="8" Padding="20,16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="TRAINER OPTIONS" Foreground="#C9D7C2" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="MISSION CONTROLS" HorizontalAlignment="Right" Foreground="#82917C" FontSize="11"/></DockPanel>
     <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,12">
      <StackPanel><CheckBox x:Name="EnemyEspToggle" Content="Enemy ESP (through walls)" Checked="EnemyEsp_Checked" Unchecked="EnemyEsp_Unchecked"/><CheckBox x:Name="InfiniteHealthToggle" Content="Infinite health" Checked="InfiniteHealth_Changed" Unchecked="InfiniteHealth_Changed"/><CheckBox x:Name="UnlimitedAmmoToggle" Content="Unlimited ammunition" Checked="CheatOption_Changed" Unchecked="CheatOption_Changed" ToolTip="Refills reserve ammo for carried weapons; magazines still reload unless No reload is enabled."/><CheckBox x:Name="NoReloadToggle" Content="No reload" Checked="CheatOption_Changed" Unchecked="CheatOption_Changed" ToolTip="Keeps carried magazines full and prevents shots consuming ammunition."/></StackPanel>
      <StackPanel><CheckBox x:Name="UnlimitedGadgetsToggle" Content="Unlimited gadgets" Checked="CheatOption_Changed" Unchecked="CheatOption_Changed" ToolTip="Refills carried consumable gadgets and medkits. Does not grant missing items."/><CheckBox x:Name="ReducedDetectionToggle" Content="Reduced detection" Checked="CheatOption_Changed" Unchecked="CheatOption_Changed" ToolTip="Reduces hostile NPC sight distances to 25%. Hearing, cameras and scripted alerts remain active."/><CheckBox x:Name="MovementSpeedToggle" Content="Movement speed" Checked="CheatOption_Changed" Unchecked="CheatOption_Changed"/>
<ComboBox x:Name="SpeedPicker" SelectedIndex="1" IsEnabled="False" SelectionChanged="SpeedPicker_Changed" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Movement speed multiplier">
 <ComboBoxItem Content="0.5x" Tag="50"/><ComboBoxItem Content="1x (normal)" Tag="100"/><ComboBoxItem Content="1.5x" Tag="150"/><ComboBoxItem Content="2x" Tag="200"/><ComboBoxItem Content="3x" Tag="300"/>
</ComboBox></StackPanel>
     </UniformGrid>
     <StackPanel Grid.Row="2"><TextBlock x:Name="CheatStatus" Text="Additional cheats are off." Foreground="#B5EF65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="EspStatus" Grid.Row="2" Text="Enemy ESP is off. Enable it, then focus the game window." Foreground="#8E9D89" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  </Grid></ScrollViewer>
  <Border Grid.Row="1" BorderBrush="#253027" BorderThickness="0,1,0,0" Padding="24,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{x:Static local:VersionInfo.TrainerLabel}" Foreground="#B5EF65" FontSize="12"/><TextBlock Text="{x:Static local:VersionInfo.GameLabel}" Foreground="#94A192" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Close" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,6" AutomationProperties.Name="Close trainer"/></Grid>
  </Border>
 </Grid>
</Window>
