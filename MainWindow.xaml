<Window x:Class="SCTrainer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Splinter Cell • Trainer" Width="820" Height="680" MinWidth="640" MinHeight="400"
 WindowStartupLocation="CenterScreen" Background="#0B100E" Foreground="#EDF1EA" FontFamily="Segoe UI"
 UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid><Grid.RowDefinitions><RowDefinition Height="175"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ClipToBounds="True">
   <Image Source="Assets/splinter-cell-header.jpg" Stretch="UniformToFill" HorizontalAlignment="Right" Width="650" Opacity="0.85"/>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0B100E" Offset="0"/><GradientStop Color="#E60B100E" Offset="0.37"/><GradientStop Color="#200B100E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000B100E" Offset=".55"/><GradientStop Color="#FF0B100E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <StackPanel Margin="24,18,0,0">
    <TextBlock Text="TOM CLANCY’S" Foreground="#A5B09F" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock Text="SPLINTER CELL" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
    <TextBlock Text="TRAINER" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" Margin="1,3,0,0"/>
    <TextBlock Text="Your mission. Your rules." Foreground="#A5B09F" Margin="1,18,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="24,0,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#141C17" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#8A958B" Width="8" Height="8" Margin="0,0,9,0"/><TextBlock x:Name="GameStatus" Text="Checking for game…" FontSize="15" FontWeight="SemiBold"/></StackPanel>
      <TextBlock x:Name="GameDetail" Text="Looking for SplinterCell.exe" Foreground="#94A192" FontSize="12" Margin="17,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Refresh game detection"/>
    </Grid>
   </Border>
   <Border Grid.Row="2" Background="#141C17" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="8" Padding="18">
 <StackPanel>
  <TextBlock Text="LOAD LEVEL" Foreground="#C9D7C2" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox Grid.ColumnSpan="2" x:Name="LevelPicker" DisplayMemberPath="Label" MinHeight="36" VerticalContentAlignment="Center" FontSize="14" AutomationProperties.Name="Select level"/>
   <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="TestConnectionButton" Content="Test connection" Click="TestConnection_Click" Margin="12,0,0,0"/><Button x:Name="LoadLevelButton" Content="Load level" Click="LoadLevel_Click" Margin="8,0,0,0"/></StackPanel>
  </Grid>
  <TextBlock x:Name="LevelStatus" Text="Save first. Load a map in the running game, or launch one when the game is closed." TextWrapping="Wrap" Foreground="#94A192" FontSize="12" Margin="0,10,0,0"/>
 </StackPanel>
</Border>
<Border Grid.Row="4" Background="#111813" BorderBrush="#263329" BorderThickness="1" CornerRadius="8" Padding="20,16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="TRAINER OPTIONS" Foreground="#C9D7C2" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="COMING NEXT" HorizontalAlignment="Right" Foreground="#82917C" FontSize="11"/></DockPanel>
     <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,12">
      <StackPanel><CheckBox Content="Infinite health" IsEnabled="False"/><CheckBox Content="Unlimited ammunition" IsEnabled="False"/><CheckBox Content="No reload" IsEnabled="False"/></StackPanel>
      <StackPanel><CheckBox Content="Unlimited gadgets" IsEnabled="False"/><CheckBox Content="Reduced detection" IsEnabled="False"/><CheckBox Content="Movement speed" IsEnabled="False"/></StackPanel>
     </UniformGrid>
     <TextBlock Grid.Row="2" Text="Options unlock as each feature is implemented and tested." Foreground="#8E9D89" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
   </Border>
  </Grid>
  </Grid></ScrollViewer>
  <Border Grid.Row="1" BorderBrush="#253027" BorderThickness="0,1,0,0" Padding="32,0">
   <Grid><TextBlock Text="DIRECT LEVEL LOADER  /  v0.3" Foreground="#7C8D78" FontSize="11" VerticalAlignment="Center"/><Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,6" AutomationProperties.Name="Close trainer"/></Grid>
  </Border>
 </Grid>
</Window>
