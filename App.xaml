<Application x:Class="SCTrainer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<SolidColorBrush x:Key="Accent" Color="#B5EF65"/>
<Style TargetType="Button">
 <Setter Property="Foreground" Value="#B5EF65"/><Setter Property="Background" Value="#18251A"/>
 <Setter Property="BorderBrush" Value="#48613A"/><Setter Property="Padding" Value="18,10"/>
 <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
 <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2C4023"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="CheckBox">
 <Setter Property="Foreground" Value="#CFD6CD"/><Setter Property="FontSize" Value="14"/>
 <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8"/>
</Style>
</Application.Resources></Application>
