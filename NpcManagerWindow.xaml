<Window x:Class="SCTrainer.NpcManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NPC manager — Splinter Assault Trainer" Width="920" Height="650" MinWidth="620" MinHeight="400"
 Background="#0B100E" Foreground="#EDF1EA" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button x:Name="SpawnButton" DockPanel.Dock="Right" Content="＋ Spawn nearby guard" Click="Spawn_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <StackPanel><TextBlock Text="SPAWNED NPCs" FontSize="23" FontWeight="SemiBold" Foreground="#B5EF65"/>
    <TextBlock x:Name="ConnectionText" Text="Connecting…" Foreground="#A5B09F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="270"/></Grid.ColumnDefinitions>
   <Border Background="#111813" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="6" Padding="12">
    <DockPanel><TextBlock x:Name="CountText" DockPanel.Dock="Top" Text="Tracked NPCs" Foreground="#C9D7C2" Margin="0,0,0,10"/>
     <TextBlock DockPanel.Dock="Bottom" Text="Trainer-spawned NPCs only · Up to 8 present&#10;Removed entries remain in the recent history." Foreground="#94A192" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     <ListBox x:Name="NpcList" Background="Transparent" BorderThickness="0" Foreground="#EDF1EA" SelectionChanged="NpcList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Tracked NPCs">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="#18221A"/><Setter Property="Foreground" Value="#EDF1EA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2B3E23"/><Setter TargetName="Row" Property="BorderBrush" Value="#B5EF65"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding HealthText}" DockPanel.Dock="Right" Foreground="#B5EF65" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Summary}" Foreground="#A5B09F" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="#141C17" BorderBrush="#2A382D" BorderThickness="1" CornerRadius="6" Padding="16">
    <DockPanel>
     <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" x:Name="RemoveButton" Content="Remove selected NPC" Click="Remove_Click" Foreground="#F1BB98" BorderBrush="#684935" Background="#281B15" HorizontalAlignment="Left"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel><TextBlock x:Name="SelectedTitle" Text="Select a spawned NPC" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="TypeText" Foreground="#94A192" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14"/>
      <TextBlock x:Name="ConditionText" Foreground="#B5EF65" FontSize="15" Margin="0,0,0,5"/>
      <TextBlock x:Name="StatsText" Foreground="#CFD6CD" TextWrapping="Wrap"/>
      <Separator Background="#2A382D" Margin="0,16"/>
      <TextBlock Text="EDIT SELECTED NPC" Foreground="#C9D7C2" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="Display name (trainer only)" Foreground="#A5B09F" Margin="0,10,0,4" FontSize="12"/>
      <TextBox x:Name="NameEdit" MaxLength="32" Background="#0B100E" Foreground="#EDF1EA" BorderBrush="#48613A" Padding="7" AutomationProperties.Name="NPC display name"/>
      <Button x:Name="RenameButton" Content="Rename" Click="Rename_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,12"/>
      <WrapPanel><TextBox x:Name="HealthEdit" Text="100" Width="70" Background="#0B100E" Foreground="#EDF1EA" BorderBrush="#48613A" Padding="7" VerticalContentAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="NPC health from 1 to 100"/><Button x:Name="HealthButton" Content="Set health" Click="Health_Click" Padding="12,7" Margin="0,0,8,8"/><Button x:Name="HealButton" Content="Restore health" Click="Heal_Click" Padding="12,7" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Health edits apply to living, conscious NPCs. They do not revive an NPC." Foreground="#94A192" FontSize="11" TextWrapping="Wrap"/>
      <Separator Background="#2A382D" Margin="0,16"/>
      <TextBlock Text="OBSERVED STATE" Foreground="#C9D7C2" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock x:Name="StateText" Foreground="#A5B09F" TextWrapping="Wrap" Margin="0,8,0,16"/>
      
     </StackPanel>
    </ScrollViewer></DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="Close" DockPanel.Dock="Right" Click="Close_Click" Padding="16,7" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" Text="Spawn a guard in an open area. Select a roster entry to inspect it." Foreground="#A5B09F" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/></DockPanel>
 </Grid>
</Window>
